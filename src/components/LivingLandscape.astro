---
import { url } from '../lib/posts';
const ripples = Array.from({ length: 22 }, (_, i) => ({
  x: 730 + ((i * 79) % 760),
  y: 22 + ((i * 31) % 148),
  length: 35 + ((i * 43) % 150),
}));
---

<div class="living-landscape" aria-hidden="true">
  <div class="lake-refraction">
    <img
      class="lake-texture"
      src={url('/images/mist-landscape-living.webp')}
      width="2172"
      height="724"
      alt=""
    />
  </div>
  <div class="lake-surface">
    <svg viewBox="0 0 1600 190" preserveAspectRatio="none" focusable="false">
      <g
        class="water-reflections"
        fill="none"
        stroke="#6e9ca9"
        stroke-width="1"
      >
        {ripples.map(({ x, y, length }, i) => (
          <path
            class="lake-ripple"
            style={`--ripple-delay:${i * -0.63}s;--ripple-duration:${4 + (i % 5)}s`}
            d={`M${x} ${y} q${length / 4} -3 ${length / 2} 0 t${length / 2} 0`}
          />
        ))}
      </g>
      <g class="water-glints" stroke="#fff" stroke-width="2" fill="none">
        <path d="M580 39h76m-190 21h128m360 31h85m-271 27h116m-464 21h83m720 20h134" />
      </g>
    </svg>
  </div>
  <div class="drifting-boat">
    <div class="boat-wake">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <img
      class="boat-body"
      src={url('/images/watercolor-boat.webp')}
      width="480"
      height="103"
      alt=""
    />
    <div class="boat-reflection">
      <img
        src={url('/images/watercolor-boat.webp')}
        width="480"
        height="103"
        alt=""
      />
    </div>
  </div>
  <div class="cloud-stream cloud-stream-high"></div>
  <div class="cloud-stream cloud-stream-low"></div>
  <div class="cloud-stream cloud-stream-lake"></div>
</div>
