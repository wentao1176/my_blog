---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import Foreground from '../components/Foreground.astro';
import LivingLandscape from '../components/LivingLandscape.astro';
import { getPosts, url } from '../lib/posts';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<Layout>
  <section class="hero">
    <div class="hero-backdrop">
      <div class="hero-mist" aria-hidden="true"></div>
      <div class="hero-aura" aria-hidden="true"></div>
      <div class="floating-lights" aria-hidden="true">
        {Array.from({ length: 24 }, (_, i) => (
          <span
            style={`--i:${i};--left:${8 + ((i * 31) % 85)}%;--top:${13 + ((i * 17) % 75)}%`}
          ></span>
        ))}
      </div>
      <img
        class="hero-art"
        src={url('/images/mist-landscape.webp')}
        alt="浅蓝色水墨山水，远山隐于雾中，湖畔有亭与竹影"
        width="2172"
        height="724"
        fetchpriority="high"
      />
      <LivingLandscape />
    </div>
    <Foreground />
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="small-line"></span> A PERSONAL JOURNAL
        </div>
        <h1>
          山水有相逢，
          <br />
          文字有<span>回响。</span>
        </h1>
        <p>
          写代码，也写生活。
          <br />
          在字里行间，寻一处属于自己的青山。
        </p>
        <div class="hero-actions">
          <a class="button primary" href={url('/posts/')}>
            <Icon name="book" size={18} /> 翻开我的手记
          </a>
          <a class="quiet-link" href={url('/about/')}>
            认识一下
          </a>
        </div>
        <div class="hero-note">
          <span class="seal">手记</span>
          <span>一半烟火，一半诗意</span>
        </div>
      </div>
      <div class="vertical-poem">清风徐来 · 山色入怀</div>
      <span class="hero-coordinate">
        EST. 2026 &nbsp; / &nbsp; 慢慢记录，慢慢生长
      </span>
    </div>
  </section>
  <div class="welcome-line wrap">
    <span>
      <Icon name="leaf" size={17} /> 欢迎来到我的一方天地
    </span>
    <span>关于代码、生活，以及途中遇见的美好</span>
  </div>
  <div class="content-grid wrap">
    <div class="main-column">
      <section>
        <div class="section-heading">
          <div>
            <div class="eyebrow">SELECTED STORIES</div>
            <h2>
              拾光手记 <span class="section-dot">·</span>
              <small>值得停留的篇章</small>
            </h2>
          </div>
          <a class="text-link" href={url('/posts/')}>
            全部文章
          </a>
        </div>
        <div class="featured-grid">
          {posts
            .filter((p) => p.data.featured)
            .map((post) => (
              <PostCard post={post} featured />
            ))}
        </div>
      </section>
      <section class="latest-section">
        <div class="section-heading">
          <div>
            <div class="eyebrow">RECENT ENTRIES</div>
            <h2>近来所记</h2>
          </div>
          <span class="subtle">把日子，写成一行行文字</span>
        </div>
        <div class="latest-list">
          {posts
            .filter((p) => !p.data.featured)
            .map((post) => (
              <PostCard post={post} />
            ))}
        </div>
      </section>
      <a class="all-posts-link" href={url('/archives/')}>
        沿着时间，读更多故事
      </a>
    </div>
    <Sidebar count={posts.length} tags={tags} />
  </div>
  <section class="closing-note wrap">
    <span>山川与文字，皆有余韵。</span>
    <p>愿你在这里，找到片刻安静。</p>
    <span class="tiny">UNTIL WE MEET AGAIN</span>
  </section>
</Layout>
