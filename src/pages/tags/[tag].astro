---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, url } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap((p) => p.data.tags))].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<Layout title={`标签 · ${tag}`}>
  <section class="page-intro wrap">
    <div class="eyebrow">TAG / {posts.length} ENTRIES</div>
    <h1>#{tag}</h1>
    <a class="text-link" href={url('/tags/')}>
      浏览所有标签
    </a>
  </section>
  <section class="wrap article-grid archive-content">
    {posts.map((post) => (
      <PostCard post={post} featured />
    ))}
  </section>
</Layout>
